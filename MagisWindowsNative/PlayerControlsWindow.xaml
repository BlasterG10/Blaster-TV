<Window x:Class="MagisWindowsNative.PlayerControlsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:svc="clr-namespace:MagisWindowsNative.Services"
 Title="MagisTV - Controles" Width="1000" Height="150"
 WindowStyle="None" ResizeMode="NoResize"
 Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
 Topmost="False" WindowStartupLocation="Manual"
 svc:Glass.Backdrop="Acrylic">
 <!-- No layered window: the blur needs a normal DWM-composited window (see Services/Glass.cs). -->
 <WindowChrome.WindowChrome>
  <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="PlayerControlButton" TargetType="Button">
   <Setter Property="Foreground" Value="#FBF5FF"/>
   <Setter Property="Background" Value="#A02B153E"/>
   <Setter Property="BorderBrush" Value="#563365"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Padding" Value="10,6"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="surface" Background="{TemplateBinding Background}"
       BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
       CornerRadius="10" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="surface" Property="Background" Value="#A12DFF"/>
       <Setter TargetName="surface" Property="BorderBrush" Value="#D9B6FF"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.72"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="TrackCombo" TargetType="ComboBox">
   <Setter Property="Foreground" Value="#FBF5FF"/><Setter Property="Background" Value="#2B153E"/>
   <Setter Property="BorderBrush" Value="#563365"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="30"/>
   <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="PlayerSlider" TargetType="Slider">
   <Setter Property="Foreground" Value="#C43DFF"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Height" Value="22"/>
  </Style>
 </Window.Resources>
 <Grid>
 <Border Padding="16,11" Background="{DynamicResource Glass.Bar}"
         BorderBrush="{StaticResource Glass.Edge}" BorderThickness="1" CornerRadius="8"
         SnapsToDevicePixels="True">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="7" Height="7" CornerRadius="4" Background="#C43DFF" Margin="0,0,9,0"/>
     <TextBlock x:Name="TitleText" Text="Reproduciendo" FontSize="13" FontWeight="SemiBold"
                Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="AUDIO" Foreground="#D3C1E1" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,6,0"/>
     <ComboBox x:Name="AudioTrackBox" Style="{StaticResource TrackCombo}" Width="140"
               SelectionChanged="AudioTrackBox_SelectionChanged"/>
     <TextBlock Text="SUBTÍTULOS" Foreground="#D3C1E1" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,6,0"/>
     <ComboBox x:Name="SubtitleTrackBox" Style="{StaticResource TrackCombo}" Width="150"
               SelectionChanged="SubtitleTrackBox_SelectionChanged"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="0,7,0,1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="CurrentTimeText" Text="00:00" Foreground="#E1D2EC" FontSize="10" FontWeight="SemiBold"
               VerticalAlignment="Center" Margin="0,0,10,0"/>
    <Slider x:Name="ProgressSlider" Grid.Column="1" Style="{StaticResource PlayerSlider}"
            Minimum="0" Maximum="1000" Margin="0,0,10,0"
            PreviewMouseLeftButtonDown="ProgressSlider_MouseDown" PreviewMouseLeftButtonUp="ProgressSlider_MouseUp"/>
    <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00" Foreground="#D3C1E1" FontSize="10" VerticalAlignment="Center"/>
   </Grid>
   <Grid Grid.Row="2" Margin="0,5,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button Style="{StaticResource PlayerControlButton}" Content="CH −" Width="48" Height="33" Margin="0,0,7,0"
             Click="PreviousChannel_Click" ToolTip="Canal anterior (Page Up)"/>
     <Button Style="{StaticResource PlayerControlButton}" Content="↶ 15" Width="54" Height="33" Margin="0,0,7,0"
             Click="Back15_Click" ToolTip="Retroceder 15 segundos"/>
     <Button Style="{StaticResource PlayerControlButton}" Content="Ⅱ" Width="40" Height="33" Margin="0,0,7,0"
             Click="Pause_Click" ToolTip="Pausar / continuar"/>
     <Button Style="{StaticResource PlayerControlButton}" Content="15 ↷" Width="54" Height="33" Margin="7,0,7,0"
             Click="Forward15_Click" ToolTip="Adelantar 15 segundos"/>
     <Button Style="{StaticResource PlayerControlButton}" Content="■" Width="40" Height="33"
             Click="Stop_Click" ToolTip="Detener"/>
     <Button Style="{StaticResource PlayerControlButton}" Content="CH +" Width="48" Height="33" Margin="7,0,0,0"
             Click="NextChannel_Click" ToolTip="Canal siguiente (Page Down)"/>
     <Button Style="{StaticResource PlayerControlButton}" Content="☰ Guía" Width="70" Height="33" Margin="7,0,0,0"
             Click="Guide_Click" ToolTip="Guía de canales y contenido (G)"/>
     <TextBlock x:Name="PlaybackStatusText" Text="Reproduciendo" Foreground="#91A4C7"
                FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="VOL." Foreground="#D3C1E1" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
     <Slider x:Name="VolumeSlider" Style="{StaticResource PlayerSlider}" Width="92" Minimum="0" Maximum="100" Value="80"
             ValueChanged="VolumeSlider_ValueChanged"/>
     <Button x:Name="FullscreenButton" Style="{StaticResource PlayerControlButton}" Content="⛶"
             Width="40" Height="33" Margin="12,0,0,0" Click="Fullscreen_Click"
             ToolTip="Pantalla completa (F11)"/>
    </StackPanel>
   </Grid>
  </Grid>
 </Border>
 <Border CornerRadius="8" Background="{StaticResource Glass.Sheen}" IsHitTestVisible="False"/>
 </Grid>
</Window>
