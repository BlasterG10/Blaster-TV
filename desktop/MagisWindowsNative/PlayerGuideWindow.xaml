<Window x:Class="MagisWindowsNative.PlayerGuideWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:svc="clr-namespace:MagisWindowsNative.Services"
 Title="MagisTV - Guía" Width="440" Height="620"
 WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
 WindowStartupLocation="Manual" Background="Transparent" Foreground="#FAF7FF"
 UseLayoutRounding="True" SnapsToDevicePixels="True"
 svc:Glass.Backdrop="Acrylic"
 PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput">
 <WindowChrome.WindowChrome>
  <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="GuideCloseButton" TargetType="Button">
   <Setter Property="Foreground" Value="#D6C4E1"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Width="30" Height="30">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#A12DFF"/><Setter Property="Foreground" Value="White"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="GuideCombo" TargetType="ComboBox">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{DynamicResource Glass.Field}"/>
   <Setter Property="BorderBrush" Value="#4A285D"/><Setter Property="Padding" Value="8,6"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="GuideItem" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="2">
     <ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#2B163F"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#3D2057"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>

 <Grid>
 <Border Background="{DynamicResource Glass.Panel}" BorderBrush="{StaticResource Glass.Edge}" BorderThickness="1" CornerRadius="8">
  <Grid Margin="14,12,14,10">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <!-- Header -->
   <Grid Grid.Row="0" Margin="0,0,0,10">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="8" Height="8" CornerRadius="4" Background="#C43DFF" Margin="0,0,9,0"/>
     <TextBlock Text="GUÍA" FontSize="15" FontWeight="Bold"/>
     <TextBlock Text="  ·  canales y contenido" FontSize="12" Foreground="#A487B5" VerticalAlignment="Center"/>
    </StackPanel>
    <Button Style="{StaticResource GuideCloseButton}" Content="✕" HorizontalAlignment="Right"
            Click="Close_Click" ToolTip="Cerrar guía (Esc)"/>
   </Grid>

   <!-- Type and category filters -->
   <Grid Grid.Row="1" Margin="0,0,0,8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="TypeBox" Style="{StaticResource GuideCombo}" SelectionChanged="TypeBox_SelectionChanged"
              ToolTip="Tipo de contenido"/>
    <ComboBox x:Name="CategoryCombo" Grid.Column="2" Style="{StaticResource GuideCombo}" SelectionChanged="CategoryCombo_SelectionChanged"
              ToolTip="País y categoría"/>
   </Grid>

   <!-- Search -->
   <Grid Grid.Row="2" Margin="0,0,0,8">
    <TextBox x:Name="SearchBox" Foreground="#FAF7FF" Background="{DynamicResource Glass.Field}" BorderBrush="#4A285D"
             CaretBrush="White" Padding="12,9" Margin="0" FontSize="13" TextChanged="SearchBox_TextChanged"
             ToolTip="Escribe para buscar (Ctrl+F)"/>
    <TextBlock Text="⌕  Buscar canal, película o serie…" Foreground="#8B729D" FontSize="13"
               Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
     <TextBlock.Style>
      <Style TargetType="TextBlock">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
         <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
   </Grid>

   <!-- Channel / content list -->
   <ListBox x:Name="GuideList" Grid.Row="3" Background="Transparent" BorderThickness="0" Foreground="White"
            ItemContainerStyle="{StaticResource GuideItem}" SelectionMode="Single"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.CanContentScroll="True"
            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            MouseDoubleClick="GuideList_MouseDoubleClick">
    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.GroupStyle>
     <GroupStyle>
      <GroupStyle.HeaderTemplate>
       <DataTemplate>
        <Border Background="{DynamicResource Glass.Header}" CornerRadius="6" Padding="10,6" Margin="0,8,0,3">
         <TextBlock Text="{Binding Name}" Foreground="#E6C9FF" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
        </Border>
       </DataTemplate>
      </GroupStyle.HeaderTemplate>
     </GroupStyle>
    </ListBox.GroupStyle>
    <ListBox.ItemTemplate>
     <DataTemplate>
      <Grid Height="58">
       <Border Width="4" HorizontalAlignment="Left" Margin="0,8" CornerRadius="2" Background="#C43DFF">
        <Border.Style>
         <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
         </Style>
        </Border.Style>
       </Border>
       <Grid Margin="12,0,8,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="40" Height="40" CornerRadius="8" Background="#35134F" ClipToBounds="True" VerticalAlignment="Center">
         <Grid>
          <TextBlock Text="▶" FontSize="14" Foreground="#E1C3FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Image Source="{Binding Logo, Converter={x:Static svc:ThumbnailConverter.Instance}}" Stretch="UniformToFill"/>
         </Grid>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0">
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#F4F6FC" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#C9B7D8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding NextText}" FontSize="10" Foreground="#977BAA" Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Style.Triggers><DataTrigger Binding="{Binding NextText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
        </StackPanel>
        <Border Grid.Column="2" Background="#A12DFF" CornerRadius="5" Padding="7,3" VerticalAlignment="Center">
         <Border.Style>
          <Style TargetType="Border">
           <Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style>
         </Border.Style>
         <TextBlock Text="AHORA" FontSize="9" FontWeight="Bold" Foreground="White"/>
        </Border>
       </Grid>
      </Grid>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>

   <!-- Footer -->
   <Grid Grid.Row="4" Margin="2,8,2,0">
    <TextBlock x:Name="CountText" Text="0 elementos" Foreground="#9A83AE" FontSize="10" FontWeight="SemiBold"/>
    <TextBlock Text="↑↓ Navegar  ·  Enter Reproducir  ·  Esc Cerrar" Foreground="#8B729D" FontSize="10" HorizontalAlignment="Right"/>
   </Grid>
  </Grid>
 </Border>
 <Border CornerRadius="8" Background="{StaticResource Glass.Sheen}" IsHitTestVisible="False"/>
 </Grid>
</Window>
