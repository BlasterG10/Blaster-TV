<Window x:Class="MagisWindowsNative.CatalogDiscoveryWindow" Icon="Assets/MagisTV.ico"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Descubrir películas y series" Height="760" Width="1180" MinHeight="620" MinWidth="900"
 WindowStartupLocation="CenterOwner" Style="{StaticResource Glass.Window.Deep}" Foreground="#FAF7FF">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,16">
   <TextBlock Text="Descubrir películas y series" FontSize="25" FontWeight="Bold"/>
   <TextBlock Text="Busca metadatos, pósteres, sinopsis y episodios. La reproducción sigue dependiendo de tus fuentes M3U/Xtream." Foreground="#B3A0C3" Margin="0,5,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <TabControl Grid.Row="1" Background="{DynamicResource Glass.Well}" Foreground="White" BorderBrush="#4A285D">
   <TabItem Header="Películas · OMDb">
    <Grid Margin="14">
     <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="Buscar" Click="MovieSearch_Click" Padding="18,9" Background="#A12DFF"/>
      <TextBox x:Name="MovieSearchBox" Height="38" VerticalContentAlignment="Center" ToolTip="Nombre de la película" KeyDown="MovieSearchBox_KeyDown"/>
     </DockPanel>
     <ListBox x:Name="MovieResults" Grid.Row="1" SelectionChanged="MovieResults_SelectionChanged" Background="#13091E" BorderBrush="#35204C" BorderThickness="1"/>
     <Grid Grid.Row="1" Grid.Column="1" Margin="18,0,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#21102F" CornerRadius="12" Padding="8" Height="270" VerticalAlignment="Top">
       <Image x:Name="MoviePoster" Stretch="Uniform"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="18,0,0,0">
       <TextBlock x:Name="MovieTitle" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
       <TextBlock x:Name="MovieMeta" Foreground="#A8B4CF" Margin="0,7,0,12" TextWrapping="Wrap"/>
       <TextBlock Text="SINOPSIS" Foreground="#C43DFF" FontSize="10" FontWeight="Bold"/>
       <TextBlock x:Name="MovieSummary" Foreground="#E1D2EC" TextWrapping="Wrap" Margin="0,6,0,0"/>
       <TextBlock Text="Fuente: OMDb. Los metadatos no incluyen el vídeo." Foreground="#987FA8" FontSize="10" Margin="0,18,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="Series · TVmaze">
    <Grid Margin="14">
     <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="Buscar" Click="SeriesSearch_Click" Padding="18,9" Background="#A12DFF"/>
      <TextBox x:Name="SeriesSearchBox" Height="38" VerticalContentAlignment="Center" ToolTip="Nombre de la serie" KeyDown="SeriesSearchBox_KeyDown"/>
     </DockPanel>
     <ListBox x:Name="SeriesResults" Grid.Row="1" SelectionChanged="SeriesResults_SelectionChanged" Background="#13091E" BorderBrush="#35204C" BorderThickness="1"/>
     <Grid Grid.Row="1" Grid.Column="1" Margin="18,0,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Background="#21102F" CornerRadius="12" Padding="8" Height="210" VerticalAlignment="Top">
        <Image x:Name="SeriesPoster" Stretch="Uniform"/>
       </Border>
       <StackPanel Grid.Column="1" Margin="16,0,0,12">
        <TextBlock x:Name="SeriesTitle" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock x:Name="SeriesMeta" Foreground="#A8B4CF" Margin="0,7,0,10" TextWrapping="Wrap"/>
        <TextBlock x:Name="SeriesSummary" Foreground="#E1D2EC" TextWrapping="Wrap" MaxHeight="115"/>
        <TextBlock Text="Episodios informativos · No son enlaces de reproducción" Foreground="#987FA8" FontSize="10" Margin="0,8,0,0"/>
       </StackPanel>
      </Grid>
      <DockPanel Grid.Row="1" Margin="0,8,0,0">
       <TextBlock DockPanel.Dock="Top" Text="EPISODIOS" Foreground="#C43DFF" FontSize="10" FontWeight="Bold" Margin="0,0,0,7"/>
       <ListBox x:Name="SeriesEpisodes" Background="#13091E" BorderBrush="#35204C" BorderThickness="1"/>
      </DockPanel>
     </Grid>
    </Grid>
   </TabItem>
  </TabControl>
  <DockPanel Grid.Row="2" Margin="0,12,0,0">
   <TextBlock x:Name="CatalogStatus" Text="Listo para buscar." Foreground="#AC98BE" VerticalAlignment="Center"/>
   <Button DockPanel.Dock="Right" Content="Cerrar" Click="Close_Click" Padding="18,9"/>
  </DockPanel>
 </Grid>
</Window>
